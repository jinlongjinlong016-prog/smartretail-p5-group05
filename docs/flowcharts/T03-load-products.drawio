<mxfile host="app.diagrams.net"><diagram name="T03-load-products"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="START&lt;br&gt;loadProducts(dataDir, products)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="165" y="13" width="330" height="64" as="geometry"/></mxCell><mxCell id="n2" value="file.open(dataDir + &quot;/products.csv&quot;)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="165" y="115" width="330" height="50" as="geometry"/></mxCell><mxCell id="n3" value="file.is_open() ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="195" width="260" height="100" as="geometry"/></mxCell><mxCell id="n4" value="cerr &lt;&lt; &quot;Cannot open&lt;br&gt; products.csv&quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="218" width="280" height="54" as="geometry"/></mxCell><mxCell id="n5" value="END&lt;br&gt;return false" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="317" width="200" height="56" as="geometry"/></mxCell><mxCell id="n6" value="getline(file, line)  // skip header&lt;br&gt;lineNo = 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="165" y="327" width="330" height="56" as="geometry"/></mxCell><mxCell id="n7" value="" style="ellipse;fillColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="326" y="411" width="8" height="8" as="geometry"/></mxCell><mxCell id="n8" value="getline(file, line) ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="435" width="300" height="110" as="geometry"/></mxCell><mxCell id="n9" value="END&lt;br&gt;return true" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="462" width="200" height="56" as="geometry"/></mxCell><mxCell id="n10" value="lineNo = lineNo + 1&lt;br&gt;fie